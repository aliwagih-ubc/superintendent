# ============================================================================
# Superintendent. Environment configuration.
# Copy this file to .env and fill in values. The `npm run setup` wizard will
# create and populate .env for you; this file is the reference.
# ============================================================================

# Linear authentication (choose ONE of the two options below).
# The `npm run setup` wizard uses the personal API key option.
#
# Option 1 (recommended, what the wizard writes): a personal API key.
# Create one in Linear: Settings > Security & access > Personal API keys > New API key.
# https://linear.app/settings/account/security
LINEAR_PERSONAL_TOKEN=lin_api_xxxx
LINEAR_WORKSPACE_SLUG=your-workspace
#
# Option 2: OAuth application credentials (for agent actor mode).
# Create an application at https://linear.app/<workspace>/settings/api/applications/new
# LINEAR_CLIENT_ID=your-client-id
# LINEAR_CLIENT_SECRET=your-client-secret

# Required: Team ID (must be a UUID, not the team key like "ENG")
LINEAR_TEAM_ID=your-team-uuid
# Optional: Filter to a specific project (must be a UUID)
# LINEAR_PROJECT_ID=your-project-uuid

# Anthropic API Configuration
ANTHROPIC_API_KEY=sk-ant-xxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# GitHub Repository Configuration
# The repository where agents will create branches and PRs
GITHUB_REPO=owner/repo-name

# Agent Configuration
# Maximum concurrent analysis tasks (evaluate, refine, etc.)
AGENTS_MAX_CONCURRENT=5
# Maximum concurrent Claude Code instances (set to 1 for development)
AGENTS_MAX_CODE_EXECUTORS=1
AGENTS_WORK_DIR=/path/to/target/repo
AGENTS_TIMEOUT_MINUTES=60
AGENTS_MAX_RETRIES=2
# Default coding provider: claude-code | gemini | codex (per-ticket override via a Linear `provider:<name>` label)
CODING_PROVIDER=claude-code

# Agent Model Configuration (optional, uses defaults if not set)
# AGENTS_MODEL_FAST=claude-haiku-4-5
# AGENTS_MODEL_STANDARD=claude-sonnet-4-6
# AGENTS_MODEL_ADVANCED=claude-opus-4-8

# Daemon Configuration
DAEMON_POLL_INTERVAL_SECONDS=30

# Debug Mode Configuration
# Enable debug mode to save prompts and include them in Linear comments
DEBUG_MODE=false
# Directory where prompts will be cached (relative to AGENTS_WORK_DIR)
# DEBUG_CACHE_PROMPTS_DIR=.superintendent/cached-prompts
